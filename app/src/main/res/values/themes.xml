<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme -->
    <style name="Theme.Matchbook" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0B0C0F</item>
    </style>

    <!-- System launch screen (Android 12+ and, through core-splashscreen, older versions) -->
    <style name="Theme.Matchbook.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0B0C0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Matchbook</item>
    </style>
</resources>
